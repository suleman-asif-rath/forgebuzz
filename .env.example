# ------------------------------------------------------------------
# ForgeBuzz environment. Copy this file to `.env.local` and fill in.
# EVERYTHING is optional: with NO keys set, the app runs in DRY-RUN mode
# and generates real branded cards locally without posting or paid APIs.
# Add keys to turn on each real service. See README.md for how to get them.
# ------------------------------------------------------------------

# --- AI copywriter (headlines + captions) -------------------------
# Free key from https://aistudio.google.com  (Get API key).
# Without it, a built-in local writer is used instead.
GEMINI_API_KEY=

# --- Background photos --------------------------------------------
# Free key from https://www.pexels.com/api/
# Without it, cards use branded gradient backgrounds.
PEXELS_API_KEY=

# --- Storage + queue (production) ---------------------------------
# Free project from https://supabase.com
# Without these, a local JSON file store + public/generated/ is used
# (fine for local demo; NOT for Vercel, whose filesystem is ephemeral).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public bucket name for rendered card images:
SUPABASE_BUCKET=forgebuzz

# --- Instagram posting (Instagram API with Instagram Login) -------
# No Facebook Page needed. From your Meta app: add the Instagram product,
# "API setup with Instagram login". IG_ACCESS_TOKEN = long-lived Instagram
# USER token; IG_USER_ID = your Instagram account id.
# Without these, posting is logged instead of sent (DRY-RUN).
IG_ACCESS_TOKEN=
IG_USER_ID=
META_API_VERSION=v23.0

# --- Automation security ------------------------------------------
# A random string. GitHub Actions must send it as the X-Cron-Secret
# header to trigger /api/generate and /api/publish in production.
CRON_SECRET=

# --- Tuning (optional) --------------------------------------------
POSTS_PER_DAY=6
# Public base URL of THIS app (used to build image URLs for Meta).
# Set to your Vercel URL in production, e.g. https://forgebuzz.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
