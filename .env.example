# ------------------------------------------------------------------
# ForgeBuzz environment. Copy this file to `.env.local` and fill in.
# EVERYTHING is optional: with NO keys set, the app runs in DRY-RUN mode
# and generates real memes locally without posting or paid APIs.
# Add keys to turn on each real service. See README.md for how to get them.
# ------------------------------------------------------------------

# --- AI joke writer (meme text + captions) ------------------------
# Free keys from https://aistudio.google.com. Provide one or more,
# comma-separated, and the app rotates through them to spread quota.
# Without any, NO memes are written — a bad auto-generated meme costs the
# brand more than a missing one, so the pipeline skips rather than guesses.
GEMINI_API_KEYS=

# The model. Overridable because Google retires models on API keys:
# gemini-2.5-flash became "no longer available to new users", which silently
# 404s newer keys while older ones keep working. If the logs fill with 404s,
# change this rather than redeploying code. Note: the "gemini-flash-latest"
# alias returns 503 consistently — do not use it.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Photos + stock clips -----------------------------------------
# Free keys: https://www.pexels.com/api/ and https://pixabay.com/api/docs/
# Pexels is tried first, then Pixabay. Photos back the memes; clips back the
# reels. Without either, memes fall back to a brand gradient.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Storage + queue (production) ---------------------------------
# Free project from https://supabase.com
# Without these, a local JSON file store + public/generated/ is used
# (fine for local demo; NOT for Vercel, whose filesystem is ephemeral).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public bucket name for memes, reels and the reel music:
SUPABASE_BUCKET=forgebuzz

# --- Meta posting (Instagram + Facebook) --------------------------
# From your Meta Developer app (see README Phase 0).
# Without these, posting is logged instead of sent (DRY-RUN).
META_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
META_API_VERSION=v23.0

# --- Automation security ------------------------------------------
# A random string. GitHub Actions must send it as the X-Cron-Secret
# header to trigger /api/generate, /api/reel and /api/publish in production.
CRON_SECRET=

# Optional: password for the dashboard pages (Basic Auth). If unset, the
# dashboard falls back to using CRON_SECRET as the password. Username is
# anything. The /api/* timer routes are never gated by this.
DASHBOARD_PASSWORD=

# --- Tuning (optional) --------------------------------------------
# Default posts per day. The dashboard overrides this once you save settings.
POSTS_PER_DAY=6
# Public base URL of THIS app (used to build image URLs for Meta).
# Set to your Vercel URL in production, e.g. https://forgebuzz.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
